{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:yahoo": "esbuild tests/yahoo.test.ts --bundle --platform=node --format=cjs --external:pg-native --outfile=/tmp/draft-yahoo-tests.cjs && node --test /tmp/draft-yahoo-tests.cjs",
    "test:draft-data": "esbuild tests/draft-data.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nba-feed-tests.cjs && node --test /tmp/nba-feed-tests.cjs",
    "test:eligibility": "esbuild tests/yahoo-eligibility.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nba-eligibility-tests.cjs && node --test /tmp/nba-eligibility-tests.cjs",
    "test:schedule": "esbuild tests/nba-schedule.test.ts --bundle --platform=node --format=cjs --outfile=/tmp/nba-schedule-tests.cjs && node --test /tmp/nba-schedule-tests.cjs"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
