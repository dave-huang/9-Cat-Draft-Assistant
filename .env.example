# Copy to .env for local use (never commit .env). Hosting providers take these as
# environment variables / secrets in their dashboard instead.

# Server-side only. Needed for Weekly/Trades screenshot import (Gemini 3.5 Flash-Lite).
# Without it everything else works and screenshot import reports "not configured".
GEMINI_API_KEY=

# Optional.
PORT=8080
LOG_LEVEL=info

# Optional and NOT needed: only the legacy, unused Yahoo OAuth connection reads these.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# YAHOO_REDIRECT_URI=
# SESSION_SECRET=
